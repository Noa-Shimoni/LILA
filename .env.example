# Public site URL for canonical links. Example: https://lila.co.il
NEXT_PUBLIC_SITE_URL=

# Inbox for kit waitlist and workshop leads. Falls back to the address in content/site.ts
WAITLIST_NOTIFY_EMAIL=

# Meta Pixel. Leave empty until you have a real numeric Pixel ID.
# Do not put a placeholder number here.
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API. Server only. Never expose the token in frontend code.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Optional. Used only for Meta Events Manager test events.
META_TEST_EVENT_CODE=

# Google Tag Manager container GTM-M6LHDKR9 is installed in the site code.
# Enter the GA4 measurement ID inside Google Tag Manager. Do not add a GA4 gtag.js snippet here.
